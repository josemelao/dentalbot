NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dental_assistant
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dental_assistant_test
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_API_BASE_URL=https://api.telegram.org
CHANNEL_TRANSPORT=fake
LOG_LEVEL=info
SLA_MINUTES=15

# AI: fake (default) | openai | gemini
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Below this confidence the unknown router sends the message to a human.
ROUTER_CONFIDENCE_THRESHOLD=0.6

# Message style
MESSAGE_EMOJI=true
TYPING_MIN_MS=400
TYPING_PER_CHAR_MS=25
TYPING_MAX_MS=2500

# Worker
WORKER_INTERVAL_MS=60000
REMINDER_MIN_LEAD_HOURS=20
REMINDER_MAX_LEAD_HOURS=28

SEED_TELEGRAM_CHANNEL_ID=bot-pilot
